+    /// Device-side generation step: returns the latent and the EOS logit [1, 1] (not read back).
+    pub fn generate_step_device(
+        &self,
+        state: &mut TTSState<Q>,
+        backbone_input: &Tensor<Q::T, Q::B>,
+        rng: &mut impl crate::flow_lm::Rng,
+    ) -> Result<(Tensor<Q::T, Q::B>, Tensor<Q::T, Q::B>)> {
+        let dev = backbone_input.device();
+        let empty_text = Tensor::zeros((1, 0, self.flow_lm.conditioner.dim), dev)?;
+        self.flow_lm.sample_next_latent_device(
+            backbone_input,
+            &empty_text,
+            &mut state.flow_lm_state,
+            self.lsd_decode_steps,
+            rng,
+        )
+    }
+
+    /// BOS latent [1, 1, ldim], the input for the first generation step.
+    pub fn bos_latent(&self) -> Result<Tensor<Q::T, Q::B>> {
+        self.flow_lm.bos_emb.reshape((1, 1, self.flow_lm.ldim))
+    }
+
+    /// EOS probability threshold from the model config.
+    pub fn eos_threshold(&self) -> f32 {
+        self.eos_threshold
+    }
